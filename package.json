{
  "name": "@lejvn/dsh-codex-harness",
  "version": "0.3.0",
  "description": "Codex-style coding agent preset for DeepSeek Harness (DSH) 0.2.x — terminal, filesystem, planning, web search, and skills in one bundle.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-preset",
    "codex",
    "codex-harness",
    "coding-agent",
    "agent-preset",
    "ai-coding-assistant",
    "deepseek",
    "llm-tools",
    "code-interpreter",
    "dsh-0.2.x"
  ],
  "author": "lejvn (https://github.com/lejvn)",
  "contributors": [
    "shuind (https://github.com/shuind) — original author of @shuind/dsh-codex-harness 0.2.x (DSH 0.1.x)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/lejvn/dsh-codex-harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lejvn/dsh-codex-harness.git"
  },
  "bugs": {
    "url": "https://github.com/lejvn/dsh-codex-harness/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent-preset": "0.2.0-rc.2",
    "@deepseek-ai/dsh-persona": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-instructions": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-jobs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-goal": "0.2.0-rc.2",
    "@deepseek-ai/dsh-command-goal": "0.2.0-rc.2",
    "@deepseek-ai/dsh-plan-mode": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.0-rc.2",
    "@deepseek-ai/dsh-command-compact": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-todo": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-present": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
